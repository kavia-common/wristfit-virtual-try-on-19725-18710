# Copy to .env and set values for your environment.
# Do NOT commit real secrets.

# External Perfect Corp. API
PERFECT_CORP_API_KEY=your_api_key_here
PERFECT_CORP_API_URL=https://api.perfectcorp.com/v1/hand/detect

# Behavior
# Whether to prefer using the external provider when PERFECT_CORP_API_KEY is set.
PREFER_EXTERNAL=true

# Timeout (seconds) for external HTTP requests
EXTERNAL_HTTP_TIMEOUT=12

# CORS (comma-separated origins; use "*" for development)
ALLOW_ORIGINS=*

# Environment indicator (for health check)
ENVIRONMENT=development
